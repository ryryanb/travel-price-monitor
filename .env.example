# Application
APP_ENV=development
LOG_LEVEL=info

# AWS
AWS_REGION=ap-southeast-1

# Travel price provider (Amadeus test API is the default)
TRAVEL_PROVIDER=amadeus
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
# Optional; use https://api.amadeus.com only with production-enabled credentials.
AMADEUS_BASE_URL=https://test.api.amadeus.com

# Authentication
COGNITO_USER_POOL_CLIENT_ID=
COGNITO_REGION=ap-southeast-1
# Optional local Cognito endpoint; leave empty for AWS Cognito.
COGNITO_ENDPOINT_URL=

# Notifications
SES_FROM_EMAIL=