# Application
APP_ENV=development
LOG_LEVEL=info

# AWS
AWS_REGION=ap-southeast-1

# Travel price provider (SerpApi Google Flights)
TRAVEL_PROVIDER=serpapi
SERPAPI_API_KEY=
# Optional; defaults to the SerpApi search endpoint.
SERPAPI_BASE_URL=https://serpapi.com/search.json

# Authentication
COGNITO_USER_POOL_CLIENT_ID=
COGNITO_REGION=ap-southeast-1
# Optional local Cognito endpoint; leave empty for AWS Cognito.
COGNITO_ENDPOINT_URL=

# Notifications
SES_FROM_EMAIL=